{
  "name": "pxui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run icons:validate && npm run check:generated && npm run validate:determinism && npm test && npm run build",
    "icons:validate": "tsx tooling/scripts/validate-icons.ts",
    "icons:generate": "tsx tooling/scripts/generate-all.ts",
    "generate": "tsx tooling/scripts/generate-all.ts",
    "check:generated": "tsx tooling/scripts/check-generated.ts",
    "build:icons": "tsx tooling/scripts/generate-all.ts",
    "validate": "tsx tooling/scripts/validate-icons.ts",
    "validate:icons": "tsx tooling/scripts/validate-icons.ts",
    "validate:determinism": "tsx tooling/scripts/test-determinism.ts",
    "qa:report": "tsx tooling/scripts/qa-report.ts",
    "test": "tsx --test tests/icons.test.ts tests/registry.test.ts tests/search.test.ts tests/consumer-registry.test.ts tests/contract/react.test.ts tests/contract/metadata.test.ts tests/contract/registry.test.ts tests/contract/treesaking.test.ts tests/contract/accessibility.test.ts tests/contract/motion.test.ts tests/contract/determinism.test.ts tests/contract/specification.test.ts tests/contract/product-pages.test.ts tests/unit/naming-governance.test.ts tests/contract/platform-parity.test.ts tests/scale/catalog-scale.test.ts",
    "test:scale": "tsx --test tests/scale/catalog-scale.test.ts",
    "test:parity": "tsx --test tests/contract/platform-parity.test.ts",
    "test:unit": "tsx --test tests/unit/naming-governance.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
